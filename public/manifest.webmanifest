{
  "name": "Moodler",
  "short_name": "Moodler",
  "description": "Create, edit, import and export Moodle quiz questions (Moodle XML, GIFT, Aiken) entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f9",
